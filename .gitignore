node_modules/
dist/
.vite/
*.local
# Vite's temporary copy of its config, left behind if a dev server is killed
vite.config.*.timestamp-*

# Logs: npm's, and the debug.log Chromium writes beside the project when a
# browser is started with logging on
*.log

# Environment files can hold keys; only an example belongs in the repository
.env
.env.*
!.env.example

# Tool caches and coverage reports
coverage/
.eslintcache
*.tsbuildinfo

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# The bundled song library is committed so cloned checkouts and GitHub Pages
# work immediately. Regenerate it with `npm run songs` when editing the scores.

# Your own sample pack — keep licensed audio out of version control
public/samples/*
!public/samples/README.md

# Screenshots written by scripts/shoot.mjs, look.mjs, panels.mjs and sample.mjs
shots/

# Playwright E2E artifacts
/playwright-report/
/test-results/
/blob-report/

# Downloaded 3D models before preparation; only the prepared files in public/models ship
models-src/

# Local safety copies, assistant scratch output and local tool settings
backups/
Claude outputs/
.claude/

# Old validation screenshots (47 MB): kept locally, no longer in the repository
docs/validation/
